{
  "Infrastructure": {
    "Kafka": {
      "Producers": {
        "AccountCreated": {
          "Topic": "account_created",
          "Outbox": {
            "BatchSize": 123,
            "PollingDelay": "00:00:02.000"
          }
        },
        "InvoiceCreated": {
          "Topic": "invoice_created",
          "Outbox": {
            "BatchSize": 123,
            "PollingDelay": "00:00:02.000"
          }
        }
      }
    },
    "Persistence": {
      "Postgres": {
        "Host": "localhost",
        "Port": 5432,
        "Database": "postgres",
        "Username": "postgres",
        "Password": "postgres",
        "SslMode": "Prefer",
        "Pooling": true
      }
    }
  },
  "MessagePersistence": {
    "Persistence": {
      "SchemaName": "message_persistence"
    },
    "Publishers": {
      "Default": {
        "BatchSize": 100,
        "PollingDelay": "00:00:00.500"
      }
    }
  },
  "Controllers": {
    "Invoices": {
      "DefaultPageSize": 5
    },
    "Operations": {
      "DefaultPageSize": 10
    },
    "Accounts": {
      "DefaultPageSize": 7
    }
  },
  "Presentation": {
    "Kafka": {
      "Host": "127.0.0.1:8001",
      "SecurityProtocol": "Plaintext",
      "Consumers": {
        "ApprovalResult": {
          "IsDisabled": false,
          "Topic": "approval_result",
          "Group": "bank_app.approval_result"
        }
      }
    }
  }
}